---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { getSiteConfig } from '@i18n/translations';
import Button from '@/components/common/Button.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const siteConfig = getSiteConfig(lang);
const firstName = siteConfig.name.split(' ')[0];
const lastName = siteConfig.name.split(' ').slice(1).join(' ');
---

<section id="hero" class="relative min-h-screen flex flex-col justify-between overflow-hidden pt-32 pb-12">
  <!-- Top meta row -->
  <div class="container mx-auto px-6 relative z-10">
    <div class="flex items-center justify-between font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-text-muted)]">
      <span class="inline-flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-accent-medium)] animate-pulse"></span>
        Open to work
      </span>
      <span class="hidden sm:inline">{siteConfig.location}</span>
    </div>
  </div>

  <!-- Name block -->
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-6xl">
      <p class="animate-fade-in-up kicker mb-6">{siteConfig.roles.join('  /  ')}</p>

      <h1 class="animate-fade-in-up font-serif font-light tracking-[-0.02em] leading-[0.92] text-[var(--color-text-heading)]" style="animation-delay: 0.08s;">
        <span class="block text-[15vw] md:text-[11vw] lg:text-[9.5rem]">{firstName}</span>
        <span class="block text-[15vw] md:text-[11vw] lg:text-[9.5rem] italic text-[var(--color-accent-medium)]">{lastName}<span class="text-[var(--color-accent-medium)]">.</span></span>
      </h1>

      <div class="animate-fade-in-up mt-10 grid md:grid-cols-12 gap-6 md:gap-10 items-start" style="animation-delay: 0.18s;">
        <p class="md:col-span-6 lg:col-span-5 font-serif text-lg md:text-xl text-[var(--color-text-body)] leading-relaxed">
          {t('hero.tagline')}
        </p>

        <div class="md:col-span-6 md:col-start-8 lg:col-span-5 lg:col-start-9 flex flex-col gap-4 md:items-start">
          <div class="flex flex-wrap gap-3">
            <Button href="#projects" variant="primary" size="lg">
              {t('hero.viewWork')}
            </Button>
            <Button href="#contact" variant="secondary" size="lg">
              {t('hero.getInTouch')}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom meta row -->
  <div class="container mx-auto px-6 relative z-10 mt-16">
    <div class="flex items-end justify-between">
      <a href="#about" aria-label={t('hero.scrollToAbout')} class="group inline-flex items-center gap-3 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-text-muted)] hover:text-[var(--color-text-heading)] transition-colors">
        <span class="inline-block w-10 h-px bg-[var(--color-rule-strong)] group-hover:bg-[var(--color-accent-medium)] transition-colors"></span>
        Scroll
      </a>
      <div class="hidden md:flex gap-8 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-text-muted)]">
        <span>EST. 2017</span>
        <span>8+ YRS</span>
        <span>CET / UTC+1</span>
      </div>
    </div>
  </div>
</section>
