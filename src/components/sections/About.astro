---
import { Image } from 'astro:assets';
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import Button from '@components/common/Button.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import profilImage from '@/assets/profil.png';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const roleCards = [
  {
    title: t('about.role.architect.title'),
    description: t('about.role.architect.description'),
    index: '01',
  },
  {
    title: t('about.role.developer.title'),
    description: t('about.role.developer.description'),
    index: '02',
  },
  {
    title: t('about.role.lecturer.title'),
    description: t('about.role.lecturer.description'),
    index: '03',
  },
];
---

<section id="about" class="py-24 md:py-32 rule-top">
  <div class="container mx-auto px-6">
    <SectionHeader title={t('about.title')} index="01" kicker="Profile" />

    <div class="grid md:grid-cols-12 gap-10 md:gap-12 items-start">
      <!-- Photo -->
      <div class="md:col-span-5 scroll-reveal stagger-1">
        <div class="relative">
          <div class="relative aspect-[4/5] overflow-hidden border border-[var(--color-rule-strong)]">
            <Image
              src={profilImage}
              alt="Michael Heide"
              class="w-full h-full object-cover grayscale-[0.15] contrast-[1.02]"
              loading="lazy"
            />
          </div>
          <p class="mt-3 font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--color-text-muted)]">
            Fig. 01 — {t('about.title')}
          </p>
        </div>
      </div>

      <!-- Bio & roles -->
      <div class="md:col-span-7 space-y-10">
        <div class="scroll-reveal stagger-2 space-y-4">
          <p class="font-serif text-lg md:text-xl leading-relaxed text-[var(--color-text-body)]">
            {t('about.bio1')}
          </p>
          <p class="font-serif text-lg md:text-xl leading-relaxed text-[var(--color-text-body)]">
            {t('about.bio2')}
          </p>
        </div>

        <!-- Role list — editorial index -->
        <div class="scroll-reveal stagger-3 rule-top">
          {roleCards.map((role) => (
            <div class="grid grid-cols-12 gap-4 py-5 border-b border-[var(--color-rule)] items-baseline">
              <span class="col-span-1 font-mono text-[0.7rem] tracking-[0.18em] text-[var(--color-accent-medium)]">{role.index}</span>
              <h3 class="col-span-11 md:col-span-4 font-serif text-lg font-medium text-[var(--color-text-heading)]">{role.title}</h3>
              <p class="col-span-11 col-start-2 md:col-span-7 md:col-start-7 font-serif text-sm text-[var(--color-text-muted)] leading-relaxed">{role.description}</p>
            </div>
          ))}
        </div>

        <div class="scroll-reveal stagger-5">
          <Button href="/Michael-Heide_CV.pdf" download variant="secondary" size="lg">
            {t('about.downloadCV')}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
