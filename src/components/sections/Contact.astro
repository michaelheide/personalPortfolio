---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { getSiteConfig } from '@i18n/translations';
import SocialLink from '@/components/ui/SocialLink.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const siteConfig = getSiteConfig(lang);
---

<section id="contact" class="py-24 md:py-32 rule-top relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <SectionHeader
      title={t('contact.title')}
      description={t('contact.description')}
      index="05"
      kicker="Contact"
    />

    <div class="grid md:grid-cols-12 gap-10 md:gap-12 items-start pt-8">
      <!-- Email block -->
      <div class="md:col-span-8 scroll-reveal stagger-1">
        <p class="kicker mb-4">{t('contact.emailMe')}</p>
        <div class="flex items-center gap-4 flex-wrap">
          <a
            href={`mailto:${siteConfig.email}`}
            id="email-link"
            class="font-serif text-3xl md:text-5xl lg:text-6xl font-light tracking-tight text-[var(--color-text-heading)] hover:text-[var(--color-accent-medium)] transition-colors break-all leading-[1.05]"
          >
            {siteConfig.email}
          </a>
          <button
            id="copy-email"
            data-email={siteConfig.email}
            class="inline-flex items-center justify-center w-10 h-10 border border-[var(--color-rule-strong)] text-[var(--color-text-muted)] hover:text-[var(--color-accent-medium)] hover:border-[var(--color-accent-medium)] transition-all"
            aria-label={t('contact.copyEmail')}
          >
            <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <svg id="check-icon" class="w-4 h-4 hidden text-[var(--color-accent-medium)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Meta + socials -->
      <div class="md:col-span-4 scroll-reveal stagger-2 rule-top pt-8">
        <p class="kicker mb-5">{t('contact.orFindMe')}</p>
        <div class="flex flex-wrap gap-3 mb-8">
          {siteConfig.socials.map((social) => (
            <SocialLink name={social.name} url={social.url} icon={social.icon} size="md" />
          ))}
        </div>

        <div class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-text-muted)] space-y-2">
          <p>{siteConfig.location}</p>
          <p>{siteConfig.timezone}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyButton = document.getElementById('copy-email') as HTMLButtonElement | null;
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const email = copyButton?.dataset.email ?? '';

  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');

      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    } catch (err) {
      console.error('Failed to copy email:', err);
    }
  });
</script>
