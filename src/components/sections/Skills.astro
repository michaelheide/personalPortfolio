---
import { skillCategories } from '@/data/skills';
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import SectionHeader from '@/components/ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const categoryIndex: Record<string, string> = {
  Frontend: 'i',
  Backend: 'ii',
  Architecture: 'iii',
  'AI & LLM': 'iv',
};
---

<section id="skills" class="py-24 md:py-32 rule-top">
  <div class="container mx-auto px-6">
    <SectionHeader
      title={t('skills.title')}
      description={t('skills.description')}
      index="02"
      kicker="Stack"
    />

    <div class="rule-top">
      {skillCategories.map((category, index) => (
        <div class={`scroll-reveal stagger-${(index % 4) + 1} grid grid-cols-12 gap-4 md:gap-8 py-8 border-b border-[var(--color-rule)] items-baseline`}>
          <div class="col-span-12 md:col-span-3 flex items-baseline gap-3">
            <span class="font-mono text-[0.7rem] tracking-[0.2em] text-[var(--color-accent-medium)]">
              {categoryIndex[category.name] ?? String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="font-serif text-xl md:text-2xl font-medium text-[var(--color-text-heading)]">
              {category.name}
            </h3>
          </div>

          <div class="col-span-12 md:col-span-9 flex flex-wrap gap-x-6 gap-y-2">
            {category.skills.map((skill) => (
              <span class="font-mono text-[0.82rem] tracking-[0.04em] text-[var(--color-text-body)] hover:text-[var(--color-accent-medium)] transition-colors cursor-default">
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
