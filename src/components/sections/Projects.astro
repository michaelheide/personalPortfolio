---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { getProjects } from '@i18n/translations';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const projects = getProjects(lang);
---

<section id="projects" class="py-24 md:py-32 rule-top">
  <div class="container mx-auto px-6">
    <SectionHeader
      title={t('projects.title')}
      description={t('projects.description')}
      index="03"
      kicker="Work"
    />

    <div class="rule-top">
      {projects.map((project, index) => (
        <div class={`scroll-reveal stagger-${(index % 4) + 1}`}>
          <ProjectCard project={project} featured={project.featured} lang={lang} index={index} />
        </div>
      ))}
    </div>
  </div>
</section>
