---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { getProjects } from '@i18n/translations';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const projects = getProjects(lang);

const featuredProject = projects.find((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<section id="projects" class="py-20 md:py-32 bg-gradient-to-b from-[var(--color-bg-soft)] to-[var(--color-bg-primary)]">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <SectionHeader
        title={t('projects.title')}
        description={t('projects.description')}
      />

      <!-- Projects Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        {featuredProject && (
          <div class="scroll-reveal stagger-1">
            <ProjectCard project={featuredProject} featured={true} lang={lang} />
          </div>
        )}
        {otherProjects.map((project, index) => (
          <div class={`scroll-reveal stagger-${(index % 4) + 2}`}>
            <ProjectCard project={project} lang={lang} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
