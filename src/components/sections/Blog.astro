---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { getLatestBlogPosts, getBlogOverviewUrl } from '@/lib/blog';
import BlogCard from '@/components/ui/BlogCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const posts = await getLatestBlogPosts(lang, 2);
const blogUrl = getBlogOverviewUrl(lang);
---

<section id="blog" class="py-24 md:py-32 rule-top">
  <div class="container mx-auto px-6">
    <SectionHeader
      title={t('blog.title')}
      description={t('blog.sectionDescription')}
      index="04"
      kicker="Journal"
    />

    {posts.length > 0 ? (
      <>
        <div class="grid gap-8 md:grid-cols-2 items-stretch">
          {posts.map((post, index) => (
            <div class={`scroll-reveal stagger-${index + 1}`}>
              <BlogCard post={post} lang={lang} />
            </div>
          ))}
        </div>

        <div class="scroll-reveal stagger-3 mt-12">
          <a href={blogUrl} class="btn-secondary">
            {t('blog.viewAllPosts')}
          </a>
        </div>
      </>
    ) : (
      <div class="scroll-reveal rule-top pt-8 max-w-3xl">
        <p class="font-serif text-lg text-[var(--color-text-muted)]">{t('blog.noPosts')}</p>
      </div>
    )}
  </div>
</section>
