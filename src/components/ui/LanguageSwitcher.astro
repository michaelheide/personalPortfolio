---
import { languages, defaultLang, type Lang } from '@i18n/ui';
import { getAlternateLanguage } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternateLang = getAlternateLanguage(lang);

// Get current path without lang prefix
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(de)\//, '/').replace(/^\/(de)$/, '/');

// Build the alternate URL
const alternateUrl = alternateLang === defaultLang
  ? pathWithoutLang
  : `/${alternateLang}${pathWithoutLang === '/' ? '' : pathWithoutLang}`;
---

<a
  href={alternateUrl}
  class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-text-body)] hover:text-[var(--color-accent-dark)] hover:bg-[var(--color-highlight-light)] transition-all"
  aria-label={`Switch to ${languages[alternateLang]}`}
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
  </svg>
  <span class="uppercase">{alternateLang}</span>
</a>
