---
import type { BlogEntry } from '@/lib/blog';
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { formatBlogDate, getBlogPostUrl } from '@/lib/blog';

interface Props {
  post: BlogEntry;
  lang?: Lang;
  featured?: boolean;
}

const { post, lang = defaultLang, featured = false } = Astro.props;
const t = useTranslations(lang);
const postUrl = getBlogPostUrl(post.data.routeSlug, lang);
---

<article class="group card-soft relative h-full overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--color-accent-medium)] to-transparent opacity-70"></div>

  <div class="flex h-full min-h-[26rem] flex-col p-6 md:min-h-[28rem] md:p-7">
    <div class="flex items-center justify-between gap-4 mb-5 text-sm text-[var(--color-text-muted)]">
      <time datetime={post.data.publishedAt.toISOString()}>
        {formatBlogDate(post.data.publishedAt, lang)}
      </time>
      <span class="inline-flex items-center rounded-full border border-[var(--color-highlight-medium)] bg-[var(--color-highlight-light)] px-3 py-1 text-xs font-medium text-[var(--color-text-body)]">
        {post.data.tags[0] || t('blog.latestLabel')}
      </span>
    </div>

    <h3 class="mb-3 line-clamp-3 text-xl leading-tight text-[var(--color-text-heading)]">
      <a href={postUrl} class="transition-colors hover:text-[var(--color-accent-light)]">
        {post.data.title}
      </a>
    </h3>

    <p class="mb-4 line-clamp-3 text-[var(--color-text-muted)] leading-relaxed">
      {post.data.description}
    </p>

    <p class="mb-6 line-clamp-4 text-[var(--color-text-body)] leading-relaxed">
      {post.data.excerpt}
    </p>

    <div class="mt-auto flex items-center justify-between gap-4 pt-4 border-t border-[var(--color-highlight-medium)]">
      <div class="flex flex-wrap gap-2">
        {post.data.tags.slice(0, 3).map((tag) => (
          <span class="text-xs uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
            {tag}
          </span>
        ))}
      </div>

      <a
        href={postUrl}
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-light)] transition-all duration-300 group-hover:translate-x-1"
      >
        {t('blog.readArticle')}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
