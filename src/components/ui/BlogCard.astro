---
import type { BlogEntry } from '@/lib/blog';
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { formatBlogDate, getBlogPostUrl } from '@/lib/blog';

interface Props {
  post: BlogEntry;
  lang?: Lang;
  featured?: boolean;
}

const { post, lang = defaultLang, featured = false } = Astro.props;
const t = useTranslations(lang);
const postUrl = getBlogPostUrl(post.data.routeSlug, lang);
---

<article class="group relative flex h-full flex-col border-t border-[var(--color-rule-strong)] pt-6 transition-colors">
  <div class="flex items-center justify-between gap-4 mb-4 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
    <time datetime={post.data.publishedAt.toISOString()}>
      {formatBlogDate(post.data.publishedAt, lang)}
    </time>
    <span class="text-[var(--color-accent-medium)]">
      {post.data.tags[0] || t('blog.latestLabel')}
    </span>
  </div>

  <h3 class="mb-3 font-serif text-xl md:text-2xl font-light leading-tight tracking-tight text-[var(--color-text-heading)]">
    <a href={postUrl} class="transition-colors hover:text-[var(--color-accent-medium)]">
      {post.data.title}
    </a>
  </h3>

  <p class="mb-4 font-serif text-sm text-[var(--color-text-muted)] leading-relaxed">
    {post.data.description}
  </p>

  <div class="mt-auto flex items-center justify-between gap-4 pt-5">
    <div class="flex flex-wrap gap-3">
      {post.data.tags.slice(0, 3).map((tag) => (
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
          {tag}
        </span>
      ))}
    </div>

    <a
      href={postUrl}
      class="inline-flex items-center gap-2 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-[var(--color-text-body)] transition-all duration-300 group-hover:text-[var(--color-accent-medium)]"
    >
      {t('blog.readArticle')}
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
