---
import type { Project } from '@/types';
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';

interface Props {
  project: Project;
  featured?: boolean;
  lang?: Lang;
  index?: number;
}

const { project, featured = false, lang = defaultLang, index = 0 } = Astro.props;
const t = useTranslations(lang);
const idx = String(index + 1).padStart(2, '0');
---

<article class="group border-b border-[var(--color-rule)] py-8 md:py-10 transition-colors hover:border-[var(--color-rule-strong)]">
  <div class="grid grid-cols-12 gap-4 md:gap-8 items-baseline">
    <!-- Index -->
    <div class="col-span-2 md:col-span-1">
      <span class="font-mono text-[0.7rem] tracking-[0.2em] text-[var(--color-accent-medium)]">{idx}</span>
    </div>

    <!-- Title + featured flag -->
    <div class="col-span-10 md:col-span-4">
      <div class="flex items-baseline gap-3 flex-wrap">
        <h3 class="font-serif text-2xl md:text-3xl font-light tracking-tight text-[var(--color-text-heading)] leading-tight transition-colors group-hover:text-[var(--color-accent-medium)]">
          {project.title}
        </h3>
        {featured && (
          <span class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-[var(--color-accent-medium)] border border-[var(--color-accent-medium)] px-1.5 py-0.5">
            {t('projects.featured')}
          </span>
        )}
      </div>
    </div>

    <!-- Description -->
    <div class="col-span-12 md:col-span-4 md:col-start-6">
      <p class="font-serif text-sm md:text-[0.95rem] text-[var(--color-text-body)] leading-relaxed">
        {featured ? project.longDescription || project.description : project.description}
      </p>

      <!-- Tech stack -->
      <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
        {project.technologies.slice(0, featured ? 6 : 4).map((tech) => (
          <span class="font-mono text-[0.66rem] uppercase tracking-[0.12em] text-[var(--color-text-muted)]">
            {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- Links -->
    <div class="col-span-12 md:col-span-3 md:col-start-10 flex md:justify-end gap-4 md:items-baseline">
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-[var(--color-text-body)] hover:text-[var(--color-accent-medium)] transition-colors"
        >
          <span>{t('projects.liveDemo')}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      )}
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-[var(--color-text-body)] hover:text-[var(--color-accent-medium)] transition-colors"
        >
          <span>{t('projects.github')}</span>
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
