---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<div class="text-center mb-16 scroll-reveal">
  <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text-heading)] mb-4">
    {title}
  </h2>
  <div class="w-20 h-1 bg-gradient-to-r from-[var(--color-accent-light)] to-[var(--color-accent-dark)] mx-auto rounded-full mb-6"></div>
  {description && (
    <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
      {description}
    </p>
  )}
</div>
