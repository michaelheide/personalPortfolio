---
interface Props {
  title: string;
  description?: string;
  index?: string;
  kicker?: string;
}

const { title, description, index = '00', kicker } = Astro.props;
---

<div class="mb-14 scroll-reveal rule-bottom pb-6">
  <div class="flex items-baseline gap-4 mb-3">
    <span class="section-index">{index}</span>
    {kicker && <span class="kicker">{kicker}</span>}
  </div>
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <h2 class="font-serif text-3xl md:text-5xl font-light tracking-tight text-[var(--color-text-heading)] leading-[1.05]">
      {title}
    </h2>
    {description && (
      <p class="font-serif text-base md:text-lg text-[var(--color-text-muted)] max-w-md md:text-right leading-relaxed">
        {description}
      </p>
    )}
  </div>
</div>
