---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span
  class="inline-flex items-center font-mono text-[0.78rem] tracking-[0.04em] text-[var(--color-text-body)] border border-[var(--color-rule-strong)] px-3 py-1.5 hover:border-[var(--color-accent-medium)] hover:text-[var(--color-accent-medium)] transition-colors cursor-default"
>
  {name}
</span>
