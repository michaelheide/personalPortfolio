---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations, getHomeUrl } from '@i18n/utils';
import { getSiteConfig } from '@i18n/translations';
import { getBlogOverviewUrl } from '@/lib/blog';
import SocialLink from '@/components/ui/SocialLink.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const siteConfig = getSiteConfig(lang);
const homeUrl = getHomeUrl(lang);
const blogUrl = getBlogOverviewUrl(lang);
const imprintUrl = lang === 'de' ? '/de/impressum' : '/imprint';
const privacyUrl = lang === 'de' ? '/de/datenschutz' : '/privacy';
const year = new Date().getFullYear();
---

<footer class="rule-top">
  <div class="container mx-auto px-6 py-10">
    <div class="grid gap-8 md:grid-cols-3 md:items-end">
      <!-- Mark & copyright -->
      <div>
        <a
          href={homeUrl}
          class="font-serif text-lg font-medium tracking-tight text-[var(--color-text-heading)] hover:text-[var(--color-accent-medium)] transition-colors"
        >
          {siteConfig.name.split(' ')[1]}<span class="text-[var(--color-accent-medium)]">.</span>
        </a>
        <p class="mt-3 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
          &copy; {year} — {t('footer.allRightsReserved')}
        </p>
      </div>

      <!-- Index links -->
      <nav class="flex flex-col gap-2 md:items-center">
        <a href={blogUrl} class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[var(--color-text-body)] hover:text-[var(--color-accent-medium)] transition-colors">
          {t('nav.blog')}
        </a>
        <a href={imprintUrl} class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[var(--color-text-body)] hover:text-[var(--color-accent-medium)] transition-colors">
          {t('footer.imprint')}
        </a>
        <a href={privacyUrl} class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[var(--color-text-body)] hover:text-[var(--color-accent-medium)] transition-colors">
          {t('footer.privacy')}
        </a>
      </nav>

      <!-- Socials -->
      <div class="flex md:justify-end gap-3">
        {siteConfig.socials.map((social) => (
          <SocialLink name={social.name} url={social.url} icon={social.icon} />
        ))}
      </div>
    </div>
  </div>
</footer>
