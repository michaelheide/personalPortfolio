---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations, getHomeUrl } from '@i18n/utils';
import { getSiteConfig } from '@i18n/translations';
import { getBlogOverviewUrl } from '@/lib/blog';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';

interface Props {
  lang?: Lang;
  alternateLanguageUrl?: string;
}

const { lang = defaultLang, alternateLanguageUrl } = Astro.props;
const t = useTranslations(lang);
const siteConfig = getSiteConfig(lang);
const homeUrl = getHomeUrl(lang);
const blogUrl = getBlogOverviewUrl(lang);

const navLinks = [
  { label: t('nav.about'), href: `${homeUrl}#about`, index: '01' },
  { label: t('nav.skills'), href: `${homeUrl}#skills`, index: '02' },
  { label: t('nav.projects'), href: `${homeUrl}#projects`, index: '03' },
  { label: t('nav.blog'), href: blogUrl, index: '04' },
  { label: t('nav.contact'), href: `${homeUrl}#contact`, index: '05' },
];
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-bg-primary)]/95 backdrop-blur-md transition-all duration-300"
  style="border-bottom: 1px solid transparent;"
>
  <nav class="container mx-auto px-6 py-5">
    <div class="flex items-center justify-between gap-6">
      <!-- Logo -->
      <a
        href={homeUrl}
        class="font-serif text-lg font-medium tracking-tight text-[var(--color-text-heading)] hover:text-[var(--color-accent-medium)] transition-colors"
      >
        {siteConfig.name.split(' ')[1]}<span class="text-[var(--color-accent-medium)]">.</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-7">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group inline-flex items-baseline gap-1.5 font-mono text-[0.72rem] uppercase tracking-[0.18em] text-[var(--color-text-body)] hover:text-[var(--color-text-heading)] transition-colors"
              >
                <span class="text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-medium)] transition-colors">{link.index}</span>
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Right cluster: clock, language, theme -->
      <div class="hidden md:flex items-center gap-4">
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-text-muted)] hidden lg:inline-flex items-center gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-accent-medium)] animate-pulse"></span>
          <span id="local-clock">--:--</span>
          <span class="text-[var(--color-text-muted)]">CET</span>
        </span>
        <LanguageSwitcher lang={lang} alternateUrl={alternateLanguageUrl} />
        <ThemeToggle />
      </div>

      <!-- Mobile cluster -->
      <div class="md:hidden flex items-center gap-2">
        <LanguageSwitcher lang={lang} alternateUrl={alternateLanguageUrl} />
        <ThemeToggle />
        <button
          id="mobile-menu-btn"
          class="p-2 text-[var(--color-text-heading)] hover:text-[var(--color-accent-medium)] transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path class="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6h18M3 12h18M3 18h18" />
            <path class="close-icon hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden mt-2">
      <ul class="flex flex-col">
        {
          navLinks.map((link) => (
            <li class="border-b border-[var(--color-rule)]">
              <a
                href={link.href}
                class="flex items-baseline gap-3 py-3 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-text-body)] hover:text-[var(--color-text-heading)] transition-colors"
              >
                <span class="text-[var(--color-accent-medium)]">{link.index}</span>
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileMenuBtn?.querySelector('.menu-icon');
  const closeIcon = mobileMenuBtn?.querySelector('.close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', String(!isOpen));
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Header hairline on scroll
  const header = document.getElementById('header');
  const toggleHeader = () => {
    if (!header) return;
    header.style.borderBottomColor = window.scrollY > 8
      ? 'var(--color-rule)'
      : 'transparent';
  };
  window.addEventListener('scroll', toggleHeader, { passive: true });
  toggleHeader();

  // Live CET clock
  function updateClock() {
    const el = document.getElementById('local-clock');
    if (!el) return;
    try {
      const fmt = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Berlin',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      });
      el.textContent = fmt.format(new Date());
    } catch {
      el.textContent = '';
    }
  }
  updateClock();
  setInterval(updateClock, 30000);
</script>
