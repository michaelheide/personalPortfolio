---
import { defaultLang, type Lang } from '@i18n/ui';
import { useTranslations, getHomeUrl } from '@i18n/utils';
import { getSiteConfig } from '@i18n/translations';
import { getBlogOverviewUrl } from '@/lib/blog';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';

interface Props {
  lang?: Lang;
  alternateLanguageUrl?: string;
}

const { lang = defaultLang, alternateLanguageUrl } = Astro.props;
const t = useTranslations(lang);
const siteConfig = getSiteConfig(lang);
const homeUrl = getHomeUrl(lang);
const blogUrl = getBlogOverviewUrl(lang);

const navLinks = [
  { label: t('nav.about'), href: `${homeUrl}#about` },
  { label: t('nav.skills'), href: `${homeUrl}#skills` },
  { label: t('nav.projects'), href: `${homeUrl}#projects` },
  { label: t('nav.blog'), href: blogUrl },
  { label: t('nav.contact'), href: `${homeUrl}#contact` },
];
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="container mx-auto px-6 py-4">
    <div class="glass rounded-2xl px-6 py-3 flex items-center justify-between">
      <!-- Logo -->
      <a
        href={homeUrl}
        class="text-xl font-bold text-[var(--color-text-heading)] hover:text-[var(--color-accent-dark)] transition-colors"
      >
        {siteConfig.name.split(' ')[0]}<span class="text-[var(--color-accent-medium)]">.</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-8">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[var(--color-text-body)] hover:text-[var(--color-accent-dark)] transition-colors font-medium"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- CTA Button, Language Switcher and Theme Toggle -->
      <div class="hidden md:flex items-center gap-2">
        <LanguageSwitcher lang={lang} alternateUrl={alternateLanguageUrl} />
        <ThemeToggle />
        <a
          href={`${homeUrl}#contact`}
          class="btn-primary text-sm"
        >
          {t('nav.getInTouch')}
        </a>
      </div>

      <!-- Mobile Menu Button and Theme Toggle -->
      <div class="md:hidden flex items-center gap-2">
        <LanguageSwitcher lang={lang} alternateUrl={alternateLanguageUrl} />
        <ThemeToggle />
        <button
          id="mobile-menu-btn"
          class="p-2 text-[var(--color-text-heading)] hover:text-[var(--color-accent-dark)] transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              class="menu-icon"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
            <path
              class="close-icon hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="md:hidden hidden glass rounded-2xl mt-2 p-4"
    >
      <ul class="flex flex-col gap-4">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block py-2 text-[var(--color-text-body)] hover:text-[var(--color-accent-dark)] transition-colors font-medium"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`${homeUrl}#contact`} class="btn-primary text-sm w-full justify-center">
            {t('nav.getInTouch')}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileMenuBtn?.querySelector('.menu-icon');
  const closeIcon = mobileMenuBtn?.querySelector('.close-icon');

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', String(!isOpen));
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
