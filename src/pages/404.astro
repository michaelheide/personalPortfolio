---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/site';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="min-h-[80vh] flex items-center justify-center py-20">
    <div class="container mx-auto px-6 text-center">
      <h1 class="text-8xl md:text-9xl font-bold gradient-text mb-4">404</h1>
      <h2 class="text-2xl md:text-3xl font-semibold text-[var(--color-text-heading)] mb-4">
        Page Not Found
      </h2>
      <p class="text-lg text-[var(--color-text-muted)] mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn-primary">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
