---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title={t('404.title')} description={t('404.description')} lang={lang}>
  <section class="min-h-[80vh] flex items-center justify-center py-20">
    <div class="container mx-auto px-6 text-center">
      <p class="kicker mb-6">Error</p>
      <h1 class="font-serif font-light tracking-tight text-[var(--color-text-heading)] text-8xl md:text-9xl mb-4 italic">404</h1>
      <h2 class="font-serif text-2xl md:text-3xl font-light text-[var(--color-text-heading)] mb-4">
        {t('404.title')}
      </h2>
      <p class="font-serif text-lg text-[var(--color-text-muted)] mb-10 max-w-md mx-auto">
        {t('404.description')}
      </p>
      <a href="/" class="btn-primary">
        {t('404.backHome')}
      </a>
    </div>
  </section>
</BaseLayout>
