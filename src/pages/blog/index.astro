---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogOverview from '@/components/sections/BlogOverview.astro';
import { getBlogPosts } from '@/lib/blog';
import { useTranslations } from '@i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const posts = await getBlogPosts(lang);
---

<BaseLayout
  lang={lang}
  title={t('blog.overviewMetaTitle')}
  description={t('blog.overviewMetaDescription')}
>
  <section class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="container mx-auto px-6">
      <div class="mx-auto max-w-4xl scroll-reveal revealed">
        <p class="kicker mb-6">{t('blog.eyebrow')}</p>
        <h1 class="font-serif font-light tracking-tight text-[var(--color-text-heading)] text-4xl md:text-6xl mb-6 leading-[1.05]">
          {t('blog.overviewTitle')}
        </h1>
        <p class="font-serif text-lg md:text-xl text-[var(--color-text-muted)] leading-relaxed">
          {t('blog.overviewDescription')}
        </p>
      </div>
    </div>
  </section>

  <BlogOverview posts={posts} lang={lang} />
</BaseLayout>
