---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteConfig } from '@i18n/translations';

const lang = 'en';
const siteConfig = getSiteConfig(lang);
---

<BaseLayout
  lang={lang}
  title={`Privacy Policy | ${siteConfig.name}`}
  description={`Privacy policy for the website of ${siteConfig.name}.`}
  alternateEnPath="/privacy"
  alternateDePath="/de/datenschutz"
>
  <section class="pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="container mx-auto px-6">
      <div class="mx-auto max-w-4xl">
        <p class="kicker mb-4">Legal</p>
        <h1 class="mb-10 font-serif font-light tracking-tight text-[var(--color-text-heading)] text-4xl md:text-6xl">Privacy Policy</h1>
        <div class="blog-prose">
          <p>
            This privacy policy explains what personal data may be processed when visiting this website and for what purpose.
          </p>

          <h2>Controller</h2>
          <p>
            {siteConfig.name}<br />
            {siteConfig.location}<br />
            Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </p>

          <h2>Server log files</h2>
          <p>
            When you access this website, the hosting provider may automatically collect information in so-called server log files. This may include browser type, operating system, referrer URL, IP address, date and time of the request, and similar technical information. Processing is based on the legitimate interest in ensuring secure and stable operation of the website.
          </p>

          <h2>Contact by email</h2>
          <p>
            If you contact me by email, the information you provide will be processed for the purpose of handling your request and any follow-up questions. This processing is based on Art. 6(1)(b) GDPR or Art. 6(1)(f) GDPR, depending on the nature of the request.
          </p>

          <h2>No cookies for analytics or tracking</h2>
          <p>
            This website currently does not use analytics or marketing cookies. If this changes in the future, this privacy policy will be updated accordingly.
          </p>

          <h2>Local storage for theme selection</h2>
          <p>
            To store your preferred light or dark theme, this website uses your browser's local storage. This information remains on your device and is not transmitted to me or third parties.
          </p>

          <h2>External links</h2>
          <p>
            This website links to external platforms such as GitHub, LinkedIn, or other third-party websites. When clicking such links, the privacy policies of the respective providers apply.
          </p>

          <h2>Your rights</h2>
          <p>
            You have the right to request information about your personal data, correction, deletion, restriction of processing, data portability, and to object to processing, subject to the legal requirements. You also have the right to lodge a complaint with a supervisory authority.
          </p>

          <h2>Last updated</h2>
          <p>April 1, 2026</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
